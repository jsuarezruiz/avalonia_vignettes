<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="#7052D7" />
  </Style>

  <Style Selector="HyperlinkButton.viewCode">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#4D4952" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="HyperlinkButton.viewCode:pointerover">
    <Setter Property="Foreground" Value="#7052D7" />
  </Style>

  <Style Selector="TextBlock.sampleNumber">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#A09DA5" />
  </Style>

  <Style Selector="TextBlock.sampleCategory">
    <Setter Property="FontSize" Value="8" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.9" />
    <Setter Property="Foreground" Value="#8065D8" />
  </Style>

  <Style Selector="TextBlock.sampleTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#39373E" />
  </Style>

  <Style Selector="ListBox.sampleList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.sampleList ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="ListBox.sampleList ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="ListBox.sampleList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F6F4FB" />
    <Setter Property="BorderBrush" Value="#E5E0F4" />
  </Style>

  <Style Selector="ListBox.sampleList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#F1EDFC" />
    <Setter Property="BorderBrush" Value="#8065D8" />
  </Style>

  <Style Selector="ListBox.sampleList ListBoxItem:selected TextBlock.sampleTitle">
    <Setter Property="Foreground" Value="#1F1A2B" />
  </Style>

</Styles>
