<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ParallaxTravelCardsList.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ParallaxTravelCardsList/Styles/Resources.axaml" />
        <ResourceInclude Source="avares://ParallaxTravelCardsList/Themes/TravelCard.axaml" />
        <ResourceInclude Source="avares://ParallaxTravelCardsList/Themes/HotelList.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ParallaxTravelCardsList/Styles/TextStyles.axaml" />
  </Application.Styles>

</Application>
