<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="BodyFont">avares://ProductDetailZoom/Assets/Fonts#Work Sans</FontFamily>

  <SolidColorBrush x:Key="ScreenBackgroundBrush" Color="Black" />
  <SolidColorBrush x:Key="ForegroundBrush" Color="White" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF27AEEF" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF0F668F" />

  <!-- CupertinoIcons.left_chevron, on the 24 unit grid Material icons use. -->
  <!-- Original Cupertino left_chevron, normalized from its font em to the 24-unit icon grid. -->
  <StreamGeometry x:Key="BackIconGeometry">M15.328125 20.71875 7.359375 12.9375Q7.078125 12.65625 7.078125 12.28125Q7.078125 11.859375 7.359375 11.625L15.328125 3.84375Q15.609375 3.5625 15.984375 3.5625Q16.359375 3.5625 16.640625 3.84375Q16.921875 4.125 16.921875 4.5Q16.921875 4.78125 16.640625 5.15625L9.328125 12.28125L16.640625 19.453125Q16.921875 19.828125 16.921875 20.109375Q16.921875 20.484375 16.640625 20.7421875Q16.359375 21 15.984375 21Q15.609375 21 15.328125 20.71875Z</StreamGeometry>

  <!-- Icons.add and Icons.remove. -->
  <StreamGeometry x:Key="AddIconGeometry">M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6V13z</StreamGeometry>
