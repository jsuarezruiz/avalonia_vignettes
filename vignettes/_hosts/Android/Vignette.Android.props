<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Application.cs" Link="Application.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)MainActivity.cs" Link="MainActivity.cs" />
    <AndroidResource Include="$(MSBuildThisFileDirectory)Resources/**/*"
                     Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" />
    <Using Include="$(VignetteAssembly).App" Alias="VignetteApp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildProjectDirectory)/../$(VignetteAssembly).csproj" />
  </ItemGroup>
</Project>
