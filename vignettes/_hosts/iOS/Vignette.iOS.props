<Project>
  <Import Project="$(MSBuildThisFileDirectory)../Vignette.Metadata.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)VignetteApplication.cs" Link="VignetteApplication.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Main.cs" Link="Main.cs" />
    <None Include="$(MSBuildThisFileDirectory)Info.plist" Link="Info.plist" />
    <BundleResource Include="$(MSBuildThisFileDirectory)Resources/LaunchMark.png" Link="LaunchMark.png" />
    <InterfaceDefinition Include="$(MSBuildThisFileDirectory)Resources/LaunchScreen.xib" Link="LaunchScreen.xib" />
    <PartialAppManifest Include="AppMetadata.plist" />
    <Using Include="$(VignetteAssembly).App" Alias="VignetteApp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildProjectDirectory)/../$(VignetteAssembly)/$(VignetteAssembly).csproj" />
  </ItemGroup>

  <!-- Avalonia's core package carries desktop designer support as a runtime asset.
       It is unused on iOS and produces linker warnings if it reaches the app bundle. -->
  <Target Name="RemoveAvaloniaDesignerSupportFromiOSBundle"
          AfterTargets="_ComputeAssembliesToPostprocessOnPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'Avalonia.DesignerSupport'" />
    </ItemGroup>
  </Target>
</Project>
