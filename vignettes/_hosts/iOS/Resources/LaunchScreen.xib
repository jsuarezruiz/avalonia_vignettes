<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB"
          version="3.0"
          toolsVersion="23077"
          targetRuntime="iOS.CocoaTouch"
          propertyAccessControl="none"
          useAutolayout="YES"
          launchScreen="YES"
          useTraitCollections="YES"
          colorMatched="YES">
  <device id="retina6_12" orientation="portrait" appearance="light" />
  <dependencies>
    <deployment identifier="iOS" />
    <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23058" />
    <capability name="Safe area layout guides" minToolsVersion="9.0" />
  </dependencies>
  <objects>
    <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" />
    <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder" />
    <view contentMode="scaleToFill" id="launch-view">
      <rect key="frame" x="0.0" y="0.0" width="393" height="852" />
      <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
      <subviews>
        <imageView opaque="NO"
                   clipsSubviews="YES"
                   multipleTouchEnabled="YES"
                   contentMode="scaleAspectFit"
                   image="LaunchMark"
                   translatesAutoresizingMaskIntoConstraints="NO"
                   id="launch-mark">
          <rect key="frame" x="112.5" y="341.5" width="168" height="168" />
          <constraints>
            <constraint firstAttribute="width" constant="168" id="mark-width" />
            <constraint firstAttribute="height" constant="168" id="mark-height" />
          </constraints>
        </imageView>
      </subviews>
      <viewLayoutGuide key="safeArea" id="safe-area" />
      <color key="backgroundColor" red="0.094" green="0.110" blue="0.176" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
      <constraints>
        <constraint firstItem="launch-mark" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="mark-center-x" />
        <constraint firstItem="launch-mark" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" id="mark-center-y" />
      </constraints>
      <point key="canvasLocation" x="138" y="101" />
    </view>
  </objects>
  <resources>
    <image name="LaunchMark" width="256" height="256" />
  </resources>
</document>
