<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Open Sans registers its light and semibold weights under their own family names. -->
  <FontFamily x:Key="SerifFont">avares://GooeyEdge/Assets/Fonts#DM Serif Display</FontFamily>
  <FontFamily x:Key="BodyLightFont">avares://GooeyEdge/Assets/Fonts#Open Sans Light</FontFamily>
  <FontFamily x:Key="BodySemiBoldFont">avares://GooeyEdge/Assets/Fonts#Open Sans Semibold</FontFamily>

  <SolidColorBrush x:Key="OnCardBrush" Color="White" />

  <!-- The alt colours demo.dart assigns to each page's call-to-action. -->
  <SolidColorBrush x:Key="RedAccentBrush" Color="#FF4259B2" />
  <SolidColorBrush x:Key="YellowAccentBrush" Color="#FF904E93" />
  <SolidColorBrush x:Key="BlueAccentBrush" Color="#FFFFB138" />

</ResourceDictionary>
