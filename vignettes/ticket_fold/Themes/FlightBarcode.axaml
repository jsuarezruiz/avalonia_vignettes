<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:TicketFold.Controls">

  <ControlTheme x:Key="BarcodeButtonTheme" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed /template/ Border">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:FlightBarcode}" TargetType="controls:FlightBarcode">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,14">
          <Button Theme="{StaticResource BarcodeButtonTheme}" AutomationProperties.Name="Boarding pass barcode">
            <Image Source="avares://TicketFold/Assets/Images/barcode.png" Stretch="Uniform" />
          </Button>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
