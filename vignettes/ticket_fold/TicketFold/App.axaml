<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TicketFold.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TicketFold/Styles/Resources.axaml" />
        <ResourceInclude Source="avares://TicketFold/Themes/FlightSummary.axaml" />
        <ResourceInclude Source="avares://TicketFold/Themes/FlightDetails.axaml" />
        <ResourceInclude Source="avares://TicketFold/Themes/FlightBarcode.axaml" />
        <ResourceInclude Source="avares://TicketFold/Themes/Ticket.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
