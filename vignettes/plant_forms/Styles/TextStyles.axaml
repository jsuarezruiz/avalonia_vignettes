<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PlantForms.Controls"
        xmlns:shared="using:AvaloniaVignettes.Shared.Controls">

  <!-- One class per TextStyle. -->

  <Style Selector="TextBlock.appTitle1">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="8" />
    <Setter Property="LetterSpacing" Value="1.95" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.appTitle2">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LetterSpacing" Value="-1.08" />
    <Setter Property="LineHeight" Value="35.2" />
    <Setter Property="ClipToBounds" Value="False" />
    <!-- Flutter splits a squeezed line box across ascent and descent; Avalonia tops it out. -->
    <Setter Property="RenderTransform" Value="translate(0px, -10.1px)" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.formTitle">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LetterSpacing" Value="0.22" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="ClipToBounds" Value="False" />
    <!-- Same again: without this the stacked titles are cut off by the card in front. -->
    <Setter Property="RenderTransform" Value="translate(0px, -11.5px)" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.formSection">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.imageBatch">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBlock.productName">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.63" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.productPrice">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.63" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="ClipToBounds" Value="False" />
    <!-- A line box larger than the font's own is split the same way, so the price sits lower. -->
    <Setter Property="RenderTransform" Value="translate(0px, 10px)" />
  </Style>

  <Style Selector="TextBlock.orderLabel">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.44" />
    <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
  </Style>

  <Style Selector="TextBlock.orderPrice">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.44" />
    <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
  </Style>

  <Style Selector="TextBlock.orderTotalLabel">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
  </Style>

  <Style Selector="TextBlock.orderTotal">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.63" />
    <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
  </Style>

  <Style Selector="TextBlock.inputLabel">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
  </Style>

  <Style Selector="TextBlock.labelOptional">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="8" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource OptionalBrush}" />
  </Style>

  <Style Selector="TextBlock.labelNotValid">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="8" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>

  <Style Selector="TextBlock.formError">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="LetterSpacing" Value="0.38" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>

  <Style Selector="TextBlock.submitButtonText">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.44" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBlock.optionsTitle">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.63" />
    <Setter Property="Foreground" Value="{StaticResource DarkGrayBrush}" />
  </Style>

  <!-- section_separator.dart -->
  <Style Selector="Border.separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,24" />
    <Setter Property="Background" Value="{StaticResource LightGrayBrush}" />
  </Style>

  <Style Selector="controls|FormField">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- A field that takes more than one line starts its text at the top of the box. -->
  <Style Selector="controls|FormField[IsMultiline=True]">
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <Style Selector="TextBlock.dropdownArrow">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="27" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <!-- The options list: white rows on grey, the ticked one showing its check. -->
  <Style Selector="ListBox.options">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.options ListBoxItem">
    <Setter Property="Padding" Value="40,12" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource LightGrayBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="ListBox.options ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="White" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Every row keeps its tick laid out; only the picked one shows it. -->
  <Style Selector="ListBox.options shared|MaterialIcon.tick">
    <Setter Property="Foreground" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.options ListBoxItem:selected shared|MaterialIcon.tick">
    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <Style Selector="ListBox.options ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="White" />
  </Style>

  <Style Selector="ListBox.options ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="White" />
  </Style>

  <!--
    A TextBlock stretches to the height it is given, and draws its line at the top of it, so text
    handed to a button as content would sit above the middle of the button.
  -->
  <Style Selector="Button TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.apply">
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <Style Selector="Button.apply:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource LightGrayBrush}" />
  </Style>

  <Style Selector="TextBlock.cardNetwork">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource DarkGrayBrush}" />
  </Style>

  <Style Selector="CheckBox.notify /template/ Border#NormalRectangle">
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <Style Selector="CheckBox.notify:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <Style Selector="CheckBox.notify:checked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
  </Style>

  <Style Selector="Button.text">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.formBox">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource LightGrayBrush}" />
  </Style>

  <!-- The field draws its own box, so the text box inside it brings nothing but the text. -->
  <Style Selector="TextBox.formInput">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource BaseBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="TextBox.formInput /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.formInput /template/ TextBlock#PART_Placeholder">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource HelperBrush}" />
  </Style>

  <Style Selector="TextBlock.textButton">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
  </Style>

</Styles>
