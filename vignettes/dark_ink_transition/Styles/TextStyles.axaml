<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock.header">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="36" />
  </Style>

  <Style Selector="TextBlock.subHeader">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!--
    The body asks for Barlow, which the vignette never ships, so Flutter falls back to the platform
    default. This does the same rather than substituting a face the original never shows.
  -->
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

</Styles>
