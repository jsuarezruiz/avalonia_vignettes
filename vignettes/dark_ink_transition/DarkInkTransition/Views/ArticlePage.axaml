<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DarkInkTransition.Views"
             x:Class="DarkInkTransition.Views.ArticlePage"
             x:DataType="views:ArticlePage"
             x:Name="Root">

  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
    <!-- Container(color:, padding: 37): the colour fills, and the inset is inside it. -->
    <Border Background="{Binding PageBrush}" Padding="37">
      <StackPanel>
      <Panel Height="30" />
      <TextBlock Classes="header" TextWrapping="Wrap" Foreground="{Binding TextBrush}" Text="{Binding Header}" />
      <TextBlock Classes="subHeader" Margin="0,24,0,0" Foreground="{Binding SubHeaderBrush}" Text="5 minute read" />
      <Rectangle Height="1" Margin="0,12,0,0" Fill="{Binding RuleBrush}" />
      <TextBlock Classes="body" Margin="0,24,0,64" TextWrapping="Wrap" Foreground="{Binding TextBrush}" Text="{Binding Body}" />
      </StackPanel>
    </Border>
  </ScrollViewer>

</UserControl>
