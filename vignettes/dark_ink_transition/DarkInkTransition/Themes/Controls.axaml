<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DarkInkTransition.Controls"
                    xmlns:shared="using:AvaloniaVignettes.Shared.Controls">

  <!-- A bar button: the icon and nothing else, as the original's TextButton with a clear overlay. -->
  <ControlTheme x:Key="BarButtonTheme" TargetType="Button">
    <Setter Property="Padding" Value="16,4" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="Transparent"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          BorderThickness="0"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="BarToggleButtonTheme" TargetType="ToggleButton">
    <Setter Property="Padding" Value="16,4" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="Transparent"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          BorderThickness="0"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:DarkInkBar}" TargetType="controls:DarkInkBar">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>

          <Border Background="{TemplateBinding BarBackground}">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">

              <Button Grid.Column="0" Theme="{StaticResource BarButtonTheme}" AutomationProperties.Name="Back">
                <shared:MaterialIcon IconSize="18"
                                     Data="{StaticResource BackIconGeometry}"
                                     Foreground="{Binding BarForeground, RelativeSource={RelativeSource TemplatedParent}}" />
              </Button>

              <Button Grid.Column="2" Theme="{StaticResource BarButtonTheme}" AutomationProperties.Name="Home">
                <Rectangle Width="18" Height="18" Fill="{TemplateBinding BarForeground}"
                           OpacityMask="{Binding LogoMask, RelativeSource={RelativeSource TemplatedParent}}" />
              </Button>

              <ToggleButton Grid.Column="4"
                            Name="PART_Toggle"
                            Theme="{StaticResource BarToggleButtonTheme}"
                            IsChecked="{TemplateBinding IsDark}"
                            AutomationProperties.Name="Toggle dark mode">
                <Rectangle Width="18" Height="18" Fill="{TemplateBinding BarForeground}"
                           Opacity="{TemplateBinding ToggleOpacity}" OpacityMask="{TemplateBinding ToggleMask}" />
              </ToggleButton>

            </Grid>
          </Border>

          <Rectangle Height="2" Fill="{TemplateBinding RuleBrush}" />

        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="MiniActionTheme" TargetType="Button">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Background="{TemplateBinding Background}" CornerRadius="12"
                          Content="{TemplateBinding Content}" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:DarkInkControls}" TargetType="controls:DarkInkControls">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Three mini floating action buttons, 40 across, 20 apart. -->
        <StackPanel Orientation="Horizontal" Spacing="20" ClipToBounds="False">

          <Button Width="40" Height="40" Theme="{StaticResource MiniActionTheme}"
                  Background="{TemplateBinding ButtonBackground}" AutomationProperties.Name="Bookmark">
            <Button.RenderTransform>
              <TranslateTransform Y="{Binding FirstOffset, RelativeSource={RelativeSource TemplatedParent}}" />
            </Button.RenderTransform>
            <shared:MaterialIcon IconSize="24"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Data="{StaticResource BookmarkIconGeometry}"
                                 Foreground="{Binding ButtonForeground, RelativeSource={RelativeSource TemplatedParent}}" />
          </Button>

          <Button Width="40" Height="40" Theme="{StaticResource MiniActionTheme}"
                  Background="{TemplateBinding ButtonBackground}" AutomationProperties.Name="More">
            <Button.RenderTransform>
              <TranslateTransform Y="{Binding SecondOffset, RelativeSource={RelativeSource TemplatedParent}}" />
            </Button.RenderTransform>
            <shared:MaterialIcon IconSize="24"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Data="{StaticResource MoreIconGeometry}"
                                 Foreground="{Binding ButtonForeground, RelativeSource={RelativeSource TemplatedParent}}" />
          </Button>

          <Button Width="40" Height="40" Theme="{StaticResource MiniActionTheme}"
                  Background="{TemplateBinding ButtonBackground}" AutomationProperties.Name="Next">
            <Button.RenderTransform>
              <TranslateTransform Y="{Binding ThirdOffset, RelativeSource={RelativeSource TemplatedParent}}" />
            </Button.RenderTransform>
            <shared:MaterialIcon IconSize="24"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Data="{StaticResource ForwardIconGeometry}"
                                 Foreground="{Binding ButtonForeground, RelativeSource={RelativeSource TemplatedParent}}" />
          </Button>

        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
