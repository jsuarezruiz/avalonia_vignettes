<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="TitleFont">avares://BubbleTabBar/Assets/Fonts#Montserrat SemiBold</FontFamily>

  <!--
    Flutter's Curves.easeOutCubic is a bezier, not the polynomial Avalonia's CubicEaseOut computes,
    so the control points are named here instead.
  -->
  <SplineEasing x:Key="EaseOutCubic" X1="0.215" Y1="0.61" X2="0.355" Y2="1" />

  <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFE6E6E6" />
  <SolidColorBrush x:Key="BarBrush" Color="White" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
  <SolidColorBrush x:Key="InactiveIconBrush" Color="#FFCCCCCC" />

  <!-- One accent per tab, worn by the pill and by anything the page tints. -->
  <SolidColorBrush x:Key="HomeAccentBrush" Color="#FF01B87D" />
  <SolidColorBrush x:Key="GalleryAccentBrush" Color="#FF594CCF" />
  <SolidColorBrush x:Key="CameraAccentBrush" Color="#FF09A8D9" />
  <SolidColorBrush x:Key="LikesAccentBrush" Color="#FFCF4C7A" />
  <SolidColorBrush x:Key="SavedAccentBrush" Color="#FFF2873F" />

  <!--
    Material's outlined icon set, the same one the original pulls in through the
    outline_material_icons package.
  -->
  <StreamGeometry x:Key="HomeIcon">m12 5.69 5 4.5V18h-2v-6H9v6H7v-7.81l5-4.5M12 3 2 12h3v8h6v-6h2v6h6v-8h3L12 3z</StreamGeometry>
  <StreamGeometry x:Key="ImageIcon">M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-4.86 8.86-3 3.87L9 13.14 6 17h12l-3.86-5.14z</StreamGeometry>
